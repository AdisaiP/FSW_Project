@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "ลงทะเบียนสมาชิก — DPIM Portal";
}

@section VendorStyles {
<link rel="stylesheet" href="~/vendor/libs/bs-stepper/bs-stepper.css" />
<link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css" />
}

@section VendorScripts {
<script src="~/vendor/libs/bs-stepper/bs-stepper.js"></script>
<script src="~/vendor/libs/cleave-zen/cleave-zen.js"></script>
<script src="~/vendor/libs/select2/select2.js"></script>
<script src="~/vendor/libs/dropzone/dropzone.js"></script>
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
<style>
  :root { --dpim-green:#41AD49; --dpim-blue:#23408F; }

  /* page shell */
  body { background: var(--bs-body-bg); }
  .reg-page { min-height:100vh; display:flex; flex-direction:column; }

  /* logo header */
  .reg-logo-header {
    text-align:center;
    padding:1.75rem 1.5rem 1rem;
  }

  /* wrap the bs-stepper card */
  .reg-body {
    flex:1;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:2rem 1rem;
  }
  .reg-card {
    width:100%;
    max-width:960px;
    background:var(--bs-card-bg);
    border:1px solid var(--bs-border-color);
    border-radius:var(--bs-card-border-radius, .375rem);
    overflow:hidden;
  }

  /* terms scroll box */
  .terms-box {
    height:320px; overflow-y:auto;
    border:1px solid var(--bs-border-color);
    border-radius:8px; padding:1.25rem 1.5rem;
    font-size:.875rem; line-height:1.8;
    background:var(--bs-body-bg);
  }
  .terms-box::-webkit-scrollbar { width:6px; }
  .terms-box::-webkit-scrollbar-thumb { background:var(--bs-border-color); border-radius:3px; }

  .doc-hint { background:var(--bs-light); border-left:3px solid var(--bs-primary); padding:.75rem 1rem; border-radius:4px; font-size:.875rem; }

  .dropzone-dpim {
    border:2px dashed var(--bs-border-color); border-radius:8px;
    padding:2rem; text-align:center; cursor:pointer;
    background:var(--bs-body-bg); transition:border-color .2s;
  }
  .dropzone-dpim:hover,.dropzone-dpim.dz-drag-hover { border-color:var(--bs-primary); }
  .dropzone-dpim .dz-message { margin:0; }

  .cert-upload-box {
    border:2px dashed var(--bs-border-color); border-radius:8px;
    padding:1.25rem 1.5rem; background:var(--bs-body-bg);
    transition:border-color .2s;
  }
  .cert-upload-box:hover { border-color:var(--bs-primary); }
  .cert-upload-box .cert-label { font-weight:600; font-size:.875rem; margin-bottom:.35rem; }
  .cert-upload-box .cert-desc { font-size:.8rem; color:var(--bs-secondary-color); margin-bottom:.75rem; }
</style>
}

@section PageScripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
  // ---- Init bs-stepper ----
  const stepperEl = document.getElementById('regStepper');
  const stepper = new Stepper(stepperEl, { linear: false, animation: true });

  // Next buttons
  document.querySelectorAll('[data-step-next]').forEach(btn => {
    btn.addEventListener('click', function () {
      const step = parseInt(this.dataset.stepNext);
      // Step 0: validate terms acceptance
      if (step === 1) {
        if (!document.getElementById('agreeTerms').checked) {
          document.getElementById('termsAlert').classList.remove('d-none');
          return;
        }
        document.getElementById('termsAlert').classList.add('d-none');
      }
      // Step 3 (Review): populate summary
      if (step === 3) { updateReview(); }
      stepper.next();
    });
  });

  // Prev buttons
  document.querySelectorAll('[data-step-prev]').forEach(btn => {
    btn.addEventListener('click', () => stepper.previous());
  });

  // Terms scroll hint
  const termsBox = document.getElementById('termsBox');
  const scrollNote = document.getElementById('termsScrollNote');
  if (termsBox) {
    termsBox.addEventListener('scroll', function () {
      if (this.scrollTop + this.clientHeight >= this.scrollHeight - 20) {
        if (scrollNote) scrollNote.style.display = 'none';
      }
    });
  }

  // Member type → prefix + doc hint
  const memberTypeSelect = document.getElementById('memberType');
  const prefixWrap = document.getElementById('prefixWrap');
  const docHintEl  = document.getElementById('docHint');
  const docHints = {
    '\u0e1a\u0e38\u0e04\u0e04\u0e25\u0e18\u0e23\u0e23\u0e21\u0e14\u0e32': '<strong>\u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e41\u0e19\u0e1a:</strong><ul class="mb-0 ps-3 mt-1"><li>\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e1a\u0e31\u0e15\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e32\u0e0a\u0e19</li><li>\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e1a\u0e49\u0e32\u0e19</li></ul>',
    '\u0e19\u0e34\u0e15\u0e34\u0e1a\u0e38\u0e04\u0e04\u0e25': '<strong>\u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e41\u0e19\u0e1a:</strong><ul class="mb-0 ps-3 mt-1"><li>\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e23\u0e31\u0e1a\u0e23\u0e2d\u0e07\u0e1a\u0e23\u0e34\u0e29\u0e31\u0e17 (\u0e44\u0e21\u0e48\u0e40\u0e01\u0e34\u0e19 3 \u0e40\u0e14\u0e37\u0e2d\u0e19)</li><li>\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e1a\u0e31\u0e15\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e32\u0e0a\u0e19\u0e1c\u0e39\u0e49\u0e21\u0e35\u0e2d\u0e33\u0e19\u0e32\u0e08</li><li>\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e21\u0e2d\u0e1a\u0e2d\u0e33\u0e19\u0e32\u0e08 (\u0e16\u0e49\u0e32\u0e21\u0e35)</li></ul>',
    '\u0e27\u0e34\u0e2a\u0e32\u0e2b\u0e01\u0e34\u0e08\u0e0a\u0e38\u0e21\u0e0a\u0e19': '<strong>\u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e41\u0e19\u0e1a:</strong><ul class="mb-0 ps-3 mt-1"><li>\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e23\u0e31\u0e1a\u0e23\u0e2d\u0e07\u0e27\u0e34\u0e2a\u0e32\u0e2b\u0e01\u0e34\u0e08</li><li>\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e1a\u0e31\u0e15\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e32\u0e0a\u0e19\u0e1b\u0e23\u0e30\u0e18\u0e32\u0e19</li></ul>'
  };
  function updateMemberType(val) {
    if (prefixWrap) prefixWrap.style.display = (val === '\u0e1a\u0e38\u0e04\u0e04\u0e25\u0e18\u0e23\u0e23\u0e21\u0e14\u0e32') ? '' : 'none';
    if (docHintEl)  docHintEl.innerHTML = docHints[val] || '<span class="text-muted">\u0e01\u0e23\u0e38\u0e13\u0e32\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e2a\u0e21\u0e32\u0e0a\u0e34\u0e01\u0e01\u0e48\u0e2d\u0e19</span>';
  }
  if (memberTypeSelect) {
    memberTypeSelect.addEventListener('change', () => updateMemberType(memberTypeSelect.value));
    if (typeof $ !== 'undefined') $(memberTypeSelect).on('select2:select', e => updateMemberType(e.params.data.text));
  }

  // Duplicate ID check (mock)
  const idInput = document.getElementById('idNumber');
  const idAlert = document.getElementById('idDuplicateAlert');
  const MOCK_DUP = ['1234567890123'];
  if (idInput) {
    idInput.addEventListener('blur', function () {
      const v = this.value.replace(/\D/g, '');
      idAlert?.classList.toggle('d-none', !(v.length === 13 && MOCK_DUP.includes(v)));
    });
  }

  // Review summary
  function updateReview() {
    const g = id => (document.getElementById(id)?.value || '');
    const typeEl = document.getElementById('memberType');
    const px = document.getElementById('prefix');
    document.getElementById('rv-memberType').textContent = typeEl?.options[typeEl.selectedIndex]?.text || '\u2014';
    const pxText = px ? (px.options[px.selectedIndex]?.text || '') : '';
    document.getElementById('rv-name').textContent = (pxText + ' ' + g('firstName') + ' ' + g('lastName')).trim() || '\u2014';
    document.getElementById('rv-idNumber').textContent = g('idNumber') || '\u2014';
    document.getElementById('rv-email').textContent    = g('email') || '\u2014';
    document.getElementById('rv-phone').textContent    = g('phone') || '\u2014';
  }

  // Submit (mock)
  document.getElementById('btnSubmitReg')?.addEventListener('click', () => stepper.next());

  // Copy ref
  document.getElementById('btnCopyRef')?.addEventListener('click', function () {
    navigator.clipboard?.writeText('REG-2569-00001');
    this.textContent = '\u0e04\u0e31\u0e14\u0e25\u0e2d\u0e01\u0e41\u0e25\u0e49\u0e27!';
    setTimeout(() => { this.textContent = '\u0e04\u0e31\u0e14\u0e25\u0e2d\u0e01'; }, 2000);
  });

  // Select2
  if (typeof $ !== 'undefined' && $.fn.select2) {
    $('#memberType, #prefix').select2({ dropdownParent: document.body });
  }

  // Dropzone
  if (typeof Dropzone !== 'undefined') {
    Dropzone.autoDiscover = false;
    new Dropzone('#dropzoneArea', {
      url: '#', maxFilesize: 5, acceptedFiles: '.pdf,.jpg,.jpeg,.png',
      dictDefaultMessage: '', autoProcessQueue: false
    });
  }

  // Certificate file name display
  ['certDPIM', 'certCA'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', function () {
      const nameEl = document.getElementById(id + 'Name');
      if (nameEl) nameEl.textContent = this.files[0]?.name || 'ยังไม่ได้เลือกไฟล์';
    });
  });
});
</script>
}

@* ============================================================ *@
<div class="reg-page">

  <!-- Logo Header -->
  <div class="reg-logo-header">
    <img src="~/img/dpim-logo.png" alt="DPIM" style="width:72px;height:72px;object-fit:contain;" class="mb-2" />
    <h5 class="fw-bold mb-1" style="color:var(--dpim-blue);">กรมอุตสาหกรรมพื้นฐานและการเหมืองแร่</h5>
    <p class="text-muted mb-0" style="font-size:.85rem;">ระบบลงทะเบียนผู้ใช้งานอิเล็กทรอนิกส์ (Mining Account)</p>
  </div>

  <!-- Body -->
  <div class="reg-body">
    <div class="reg-card">

      <!-- bs-stepper: wizard-vertical (same class as CreateDeal) -->
      <div id="regStepper" class="bs-stepper wizard-vertical vertical mt-2">

        <!-- ===== LEFT: Step Header ===== -->
        <div class="bs-stepper-header gap-lg-2 border-end">

          <div class="step" data-target="#step-terms">
            <button type="button" class="step-trigger">
              <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
              <span class="bs-stepper-label">
                <span class="bs-stepper-number">01</span>
                <span class="d-flex flex-column gap-1 ms-2">
                  <span class="bs-stepper-title">ข้อตกลงและเงื่อนไข</span>
                  <span class="bs-stepper-subtitle">อ่านและยอมรับข้อตกลง</span>
                </span>
              </span>
            </button>
          </div>
          <div class="line"></div>

          <div class="step" data-target="#step-info">
            <button type="button" class="step-trigger">
              <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
              <span class="bs-stepper-label">
                <span class="bs-stepper-number">02</span>
                <span class="d-flex flex-column gap-1 ms-2">
                  <span class="bs-stepper-title">ข้อมูลพื้นฐาน</span>
                  <span class="bs-stepper-subtitle">กรอกข้อมูลสมาชิก</span>
                </span>
              </span>
            </button>
          </div>
          <div class="line"></div>

          <div class="step" data-target="#step-docs">
            <button type="button" class="step-trigger">
              <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
              <span class="bs-stepper-label">
                <span class="bs-stepper-number">03</span>
                <span class="d-flex flex-column gap-1 ms-2">
                  <span class="bs-stepper-title">แนบเอกสาร</span>
                  <span class="bs-stepper-subtitle">อัปโหลดเอกสารประกอบ</span>
                </span>
              </span>
            </button>
          </div>
          <div class="line"></div>

          <div class="step" data-target="#step-review">
            <button type="button" class="step-trigger">
              <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
              <span class="bs-stepper-label">
                <span class="bs-stepper-number">04</span>
                <span class="d-flex flex-column gap-1 ms-2">
                  <span class="bs-stepper-title">ตรวจสอบ</span>
                  <span class="bs-stepper-subtitle">ทบทวนและยืนยัน</span>
                </span>
              </span>
            </button>
          </div>
          <div class="line"></div>

          <div class="step" data-target="#step-done">
            <button type="button" class="step-trigger">
              <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
              <span class="bs-stepper-label">
                <span class="bs-stepper-number">05</span>
                <span class="d-flex flex-column gap-1 ms-2">
                  <span class="bs-stepper-title">สำเร็จ</span>
                  <span class="bs-stepper-subtitle">การลงทะเบียนเสร็จสิ้น</span>
                </span>
              </span>
            </button>
          </div>

        </div>
        <!-- /header -->

        <!-- ===== RIGHT: Content ===== -->
        <div class="bs-stepper-content">
          <form id="regForm" onsubmit="return false">

            <!-- STEP 1: ข้อตกลง -->
            <div id="step-terms" class="content">
              <div class="content-header mb-4">
                <h5 class="mb-0 fw-bold"><i class="ri ri-file-text-line me-2 text-primary"></i>ข้อตกลงและเงื่อนไข</h5>
                <small class="text-muted">การขอรับ Username &amp; Password สำหรับระบบ Mining Account กรมอุตสาหกรรมพื้นฐานและการเหมืองแร่</small>
              </div>

              <div id="termsBox" class="terms-box mb-2">
                <p style="font-size:.83rem;color:var(--bs-secondary-color);">ข้าพเจ้าผู้สมัครขอรับชื่อผู้ใช้และรหัสผ่าน (Username &amp; Password) สำหรับการใช้งานระบบลงทะเบียนผู้ใช้งานอิเล็กทรอนิกส์ (Mining Account) โดยตกลงและยินยอมผูกพันและปฏิบัติตามข้อตกลงและเงื่อนไขดังต่อไปนี้ทุกประการ</p>
                <p><strong>ข้อ 1</strong> ข้อตกลงและเงื่อนไขนี้ใช้บังคับระหว่าง กรมอุตสาหกรรมพื้นฐานและการเหมืองแร่ ซึ่งต่อไปนี้จะเรียกว่า "กรม" กับผู้สมัครขอรับชื่อผู้ใช้และรหัสผ่าน (Username &amp; Password) เพื่อใช้บริการระบบ Mining Account ซึ่งต่อไปนี้จะเรียกว่า "ผู้รับบริการ"</p>
                <p><strong>ข้อ 2</strong> ผู้รับบริการ จะต้องกรอกหรือระบุข้อมูลรายละเอียดต่าง ๆ ตามความเป็นจริงให้ครบถ้วน ทั้งนี้ เพื่อประโยชน์แก่ผู้รับบริการ และผู้รับบริการตกลงยินยอมให้ กรม ตรวจสอบความถูกต้องและเปิดเผยข้อมูลตามที่ได้ระบุไว้ หากตรวจพบว่าข้อมูลของผู้รับบริการไม่เป็นความจริง กรมอาจระงับหรือยกเลิกสิทธิการใช้งานของผู้รับบริการได้โดยไม่ต้องแจ้งให้ทราบล่วงหน้า</p>
                <p><strong>ข้อ 3</strong> เมื่อผู้รับบริการทำการกรอกข้อมูลเรียบร้อยแล้ว ให้ผู้รับบริการดำเนินการยืนยันตัวผ่านช่องทางใดช่องทางหนึ่ง ได้แก่</p>
                <p><u>กรณีบุคคลธรรมดา</u></p>
                <ol>
                  <li>ยืนยันตัวตนต่อหน้าเจ้าหน้าที่ด้วยตนเอง โดยแสดงบัตรประจำตัวประชาชนที่ยังไม่หมดอายุ</li>
                  <li>ยืนยันตัวตนผ่านระบบ e-KYC โดยใช้บัตรประจำตัวประชาชน ประกอบกับการถ่ายภาพใบหน้า (Selfie)</li>
                  <li>ยืนยันตัวตนโดยใช้ใบรับรองอิเล็กทรอนิกส์จาก CA</li>
                  <li>มอบอำนาจให้บุคคลอื่นยื่นเอกสารยืนยันตัวตนแทน พร้อมหนังสือมอบอำนาจและเอกสารประกอบ</li>
                </ol>
                <p><u>กรณีนิติบุคคล</u></p>
                <ol>
                  <li>ยืนยันตัวตนโดยใช้ใบรับรองอิเล็กทรอนิกส์จาก CA</li>
                  <li>สั่งพิมพ์คำขอรับ Username &amp; Password พร้อมแนบหนังสือรับรองนิติบุคคล, หนังสือบริคณห์สนธิ, บอจ.5, สำเนาบัตรประชาชนกรรมการผู้มีอำนาจ</li>
                </ol>
                <p>เมื่อเจ้าหน้าที่อนุมัติแล้ว ระบบจะแจ้งให้ยืนยัน Activate User ทางอีเมล ภายใน 30 วันนับแต่วันที่ได้รับแจ้ง</p>
                <p><strong>ข้อ 4</strong> ผู้รับบริการต้องไม่นำ Username &amp; Password ไปใช้ในทางที่ขัดต่อกฎหมาย และความสงบเรียบร้อยหรือศีลธรรมอันดีของประชาชน</p>
                <p><strong>ข้อ 5</strong> การสร้างลายมือชื่ออิเล็กทรอนิกส์ด้วยการใช้ Username จะต้องใช้คู่กับ Password และ OTP</p>
                <p><strong>ข้อ 6</strong> ผู้รับบริการต้องเก็บรักษา Username &amp; Password ไว้เป็นความลับ หากสงสัยว่าล่วงรู้ไปถึงบุคคลอื่น ต้องตั้งรหัสผ่านใหม่โดยทันที</p>
                <p><strong>ข้อ 7</strong> การใช้ลายมือชื่ออิเล็กทรอนิกส์ที่เกิดจากการใช้ Username &amp; Password มีความผูกพันตามกฎหมายเสมือนการลงลายมือชื่อในเอกสารทุกประการ</p>
                <p><strong>ข้อ 8</strong> กรมมีสิทธิแก้ไข เปลี่ยนแปลง หรือยกเลิกข้อตกลงนี้ได้ตามที่เห็นสมควร</p>
                <p><strong>ข้อ 9</strong> ผู้รับบริการต้องปฏิบัติตามข้อตกลงโดยเคร่งครัด กรมมีสิทธิปฏิเสธและไม่ต้องรับผิดชอบในความเสียหายที่เกิดจากเหตุสุดวิสัย</p>
                <p><strong>ข้อ 10</strong> ผู้ใดแอบอ้างหรือกระทำการละเมิดสิทธิส่วนบุคคลโดยใช้ข้อมูลของผู้อื่น ถือเป็นความผิดและต้องรับโทษตามกฎหมาย</p>
                <p><strong>ข้อ 11</strong> กรมอาจส่งข้อมูลหรือแจ้งข่าวประชาสัมพันธ์ผ่านอีเมลหรือช่องทางอื่นให้แก่ผู้รับบริการได้ตามที่เห็นสมควร</p>
                <p><strong>ข้อ 12</strong> กรมมีสิทธิระงับหรือยกเลิกการให้บริการทันที หากผู้รับบริการปฏิบัติผิดข้อตกลงแม้เพียงข้อใดข้อหนึ่ง</p>
                <p><strong>ข้อ 13</strong> การใช้ Username &amp; Password ของผู้แทนห้างหุ้นส่วนหรือบริษัทจำกัด ถือว่าเป็นไปตามความประสงค์ของผู้ประกอบการ</p>
                <p><strong>ข้อ 14</strong> กรมมีสิทธิระงับหรือยกเลิกการให้บริการทันที หากผู้รับบริการปฏิบัติผิดข้อตกลง</p>
                <p><strong>ข้อ 15</strong> คำประกาศเกี่ยวกับความเป็นส่วนตัว (Privacy Notice) สำหรับผู้รับบริการตาม พ.ร.บ.แร่ พ.ศ. 2560 — <a href="#" class="text-primary">คลิกเพื่ออ่านเพิ่มเติม</a></p>
                <p><strong>ข้อ 16</strong> กรมเก็บรวบรวมข้อมูลส่วนบุคคล ได้แก่ ชื่อ-สกุล / เลขบัตรประชาชน / ที่อยู่ / วันเดือนปีเกิด / ภาพใบหน้า</p>
                <p><strong>ข้อ 17</strong> กรมจะเก็บรักษาข้อมูลส่วนบุคคลตราบเท่าที่จำเป็น เมื่อพ้นระยะเวลาจะลบ/ทำลายหรือทำให้ไม่สามารถระบุตัวตนได้ หากต้องการยกเลิกต้องแจ้งเป็นลายลักษณ์อักษรล่วงหน้าไม่น้อยกว่า 3 วัน</p>
                <hr />
                <p class="fw-semibold">ข้าพเจ้ายอมรับ และได้อ่านข้อความในข้อตกลงและเงื่อนไขนี้เข้าใจโดยละเอียดแล้ว</p>
              </div>

